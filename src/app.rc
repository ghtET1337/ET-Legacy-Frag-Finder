1 24 "app.manifest"
101 ICON "app.ico"

1 VERSIONINFO
 FILEVERSION 1,7,6,0
 PRODUCTVERSION 1,7,6,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ght\0"
            VALUE "FileDescription", "ET: Legacy Frag Finder by ght\0"
            VALUE "FileVersion", "1.7.6\0"
            VALUE "InternalName", "ETLFragFinder\0"
            VALUE "OriginalFilename", "ETLFragFinder.exe\0"
            VALUE "ProductName", "ET: Legacy Frag Finder by ght\0"
            VALUE "ProductVersion", "1.7.6\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

#include <windows.h>
201 DIALOGEX 0, 0, 420, 276
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Cut demo (.dm_84) - ETL Frag Finder 1.7.6"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Save this action as a playable ET: Legacy demo", -1, 14, 12, 390, 14
    LTEXT "", 2101, 14, 32, 390, 22, SS_PATHELLIPSIS
    LTEXT "", 2102, 14, 58, 390, 22
    LTEXT "Seconds before the first frag", -1, 14, 88, 182, 12
    EDITTEXT 2103, 14, 104, 182, 20, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Seconds after the last frag", -1, 216, 88, 190, 12
    EDITTEXT 2104, 216, 104, 190, 20, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "", 2105, 14, 135, 390, 24
    LTEXT "Cuts follow recorded snapshots. The demo ends at the selected range. Playback requires the original map and a compatible mod.", -1, 14, 162, 390, 28
    CONTROL "", 2106, "msctls_progress32", WS_CHILD | WS_VISIBLE, 14, 197, 390, 10
    LTEXT "The original demo stays unchanged. No ETL or FFmpeg is needed to cut.", 2107, 14, 214, 390, 28
    PUSHBUTTON "Show saved file", 2109, 14, 248, 98, 20, WS_DISABLED
    DEFPUSHBUTTON "Save cut demo...", 2108, 203, 248, 106, 20
    PUSHBUTTON "Close", IDCANCEL, 317, 248, 89, 20
END
