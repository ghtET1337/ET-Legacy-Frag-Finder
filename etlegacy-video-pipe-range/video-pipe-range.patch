+/**
+ * @brief Render an exact demo-relative range through ffmpeg.
+ *
+ * Usage: video-pipe-range <filename> <startTime> <endTime>
+ * Times are seconds from the first demo snapshot. Set
+ * cl_videoPipeRangeQuit to 1 when an external queue controller wants the
+ * client to close after the encoder has flushed the completed clip.
+ */
+static void CL_VideoPipeRange_f(void)
+{
+	char       outputName[MAX_OSPATH];
+	double     startTime;
+	double     endTime;
+	const char *filename;
+	const char *extension;
+
+	if (!clc.demo.playing)
+	{
+		Com_Printf("The video-pipe-range command can only be used when playing back demos\n");
+		return;
+	}
+
+	if (Cmd_Argc() != 4)
+	{
+		Com_Printf("usage: video-pipe-range <filename> <startTime> <endTime>\n");
+		return;
+	}
+
+	filename  = Cmd_Argv(1);
+	startTime = Q_atof(Cmd_Argv(2));
+	endTime   = Q_atof(Cmd_Argv(3));
+	if (!filename[0] || startTime < 0.0 || endTime <= startTime)
+	{
+		Com_Printf("video-pipe-range: filename is required and endTime must be greater than startTime\n");
+		return;
+	}
+
+	if (CL_VideoRecording())
+	{
+		CL_StopVideo_f();
+	}
+
+	CL_DemoSeekSeconds(startTime);
+	videoPipeRangeEndServerTime = CL_DemoFirstServerTime() + (int)(endTime * 1000.0 + 0.5);
+	videoPipeRangeQuit          = Cvar_VariableIntegerValue("cl_videoPipeRangeQuit") != 0;
+	videoPipe                   = qtrue;
+	extension                   = CL_GetVideoExtension();
+	Cvar_Set("cl_avidemotype", "2");
+	if (!Q_stricmp(filename, "$demo"))
+	{
+		Com_sprintf(outputName, sizeof(outputName), "videos/%s.%s", clc.demo.demoName, extension);
+	}
+	else
+	{
+		Com_sprintf(outputName, sizeof(outputName), "videos/%s.%s", filename, extension);
+	}
+	CL_StartVideoRecording(outputName);
+	videoPipeRangeActive = CL_VideoRecording();
+
+	if (videoPipeRangeActive)
+	{
+		Com_Printf("video-pipe-range: rendering %.3f to %.3f seconds as %s\n",
+		           startTime, endTime, filename);
+	}
+	else if (videoPipeRangeQuit)
+	{
+		Cbuf_ExecuteText(EXEC_APPEND, "quit\n");
+	}
+}
+
